{
	"name": "@com.mgmtp.a12.diagrameditor/diagrameditor",
	"version": "0.0.1-intern",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"description": "Diagram-Editor Framework",
	"files": [
		"src",
		"dist",
		"dist/**/*.d.ts",
		"!dist/test",
		"cyclonedx.json",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES",
		"licenses"
	],
	"scripts": {
		"clean": "pnpm dlx rimraf build dist node_modules lib",
		"compile": "pnpm \"/^compile:.*/\"",
		"compile:src": "tsc --project ./tsconfig.json",
		"compile:test": "tsc --project test/tsconfig.json",
		"test": "vitest --silent --run",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"prettier:fix": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"devDependencies": {
		"@babel/core": "catalog:",
		"@babel/preset-env": "catalog:",
		"@babel/preset-react": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@reduxjs/toolkit": "catalog:",
		"@types/lodash": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-redux": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"core-js": "catalog:",
		"depcheck": "catalog:",
		"immer": "catalog:",
		"react": "catalog:",
		"react-redux": "catalog:",
		"styled-components": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@com.mgmtp.a12.widgets/widgets-core": "catalog:peer",
		"@reduxjs/toolkit": "catalog:peer",
		"react": "catalog:peer",
		"styled-components": "catalog:peer"
	},
	"dependencies": {
		"lodash": "catalog:",
		"uuid": "catalog:",
		"@dagrejs/dagre": "catalog:"
	}
}
